; Street Hustler — Godot 4.x
config_version=5

[application]
config/name="Street Hustler"
run/main_scene="res://scenes/boot/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="An original urban action-adventure game."

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.035, 0.043, 0.055, 1)

[input]
move_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}

[autoload]
EventBus="*res://scripts/autoload/event_bus.gd"
GameState="*res://scripts/autoload/game_state.gd"
WorldClock="*res://scripts/autoload/world_clock.gd"
SceneManager="*res://scripts/autoload/scene_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
EventManager="*res://scripts/autoload/event_manager.gd"
HustleManager="*res://scripts/autoload/hustle_manager.gd"
FactionManager="*res://scripts/autoload/faction_manager.gd"
DebugBridge="*res://scripts/autoload/debug_bridge.gd"
