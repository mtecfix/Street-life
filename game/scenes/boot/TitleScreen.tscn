[gd_scene load_steps=2 format=3]

; TITLE SCREEN SCENE
; This is the lightweight scene resource used as the game's front-end entry
; screen. It intentionally contains only a full-viewport Control root and its
; attached script. The script creates the background and menu Controls at
; runtime, keeping layout and button behavior together in title_screen.gd.
;
; The root Control stretches to the available viewport. This allows the
; full-screen background artwork and centered menu to adapt to the active
; window size. Keep this scene free of gameplay/world nodes; the menu hands
; off to the Neighborhood scene through SceneManager when the player makes
; a selection.
;
; NOTE: .tscn comments use a leading semicolon, not '#'. The Godot editor
; also discards comments from this file the next time it resaves the scene,
; so property-level explanations belong in title_screen.gd instead, where
; they persist.

[ext_resource type="Script" path="res://scripts/boot/title_screen.gd" id="1"]

[node name="TitleScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")
